# Environment
.env
.env.local
.env.*.local

# Elixir / Phoenix
_build/
deps/
*.ez
*.beam
.elixir_ls/
core-*.tar
erl_crash.dump
# ExUnit's `@tag :tmp_dir` scratch space, created relative to the app root.
apps/core/tmp/

# Elm
elm-stuff/
frontend/elm.js
# `elm make src/Main.elm --output=index.html` output — a self-contained dev page
# that embeds its own compiled JS. Nothing serves it: the SPA shell is
# apps/core/assets/index.html, copied to priv/static by apps/core/assets/build.js
# and sent by CoreWeb.PageController. It was tracked until #348, where a 39,680-line
# stale copy still carrying code deleted by #343 was poisoning repo-wide greps.
frontend/index.html
frontend/node_modules/
# Slash-free twin: `foo/` matches only a DIRECTORY, so a symlinked node_modules
# (what `just bootstrap-worktree` creates in a worktree) is NOT matched by the
# rule above and would be swept in by `git add -A`. Verify with
# `git check-ignore -v`, never by reading this file (#348).
frontend/node_modules
apps/core/assets/node_modules

# Rust
apps/scraper/target/

