__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
.venv/
.venv-tools/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Nix
result
.direnv/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

# Protobuf generated — regenerated at build time. Never commit generated files.
# Elm decoders: scripts/gen-elm-proto.sh
# Ecto schemas + dbt models: mix proto.sync
# Python Pydantic models: scripts/gen-python-proto.sh
# Elixir inter-service structs: scripts/gen-elixir-proto.sh
# Rust serde structs: scripts/gen-rust-proto.sh
# CI validates with --check.
proto/gen/
apps/core/lib/stacks/gen/
apps/vision/app/proto/gen/
apps/scraper/src/proto/generated/

# Node
node_modules/

# Claude Code — user-local files (project settings.json is checked in)
.claude/settings.local.json
.claude/worktrees/
plans/*-state.json
plans/*-state-complete.json
# ...EXCEPT a campaign's state file, which is a shared artifact rather than local run state.
# Per-issue orchestrator state above is ephemeral. A campaign's state file is the handoff a
# fresh pass resumes from and the input to `just wave-status` — so if it were ignored, a
# worktree or a fresh clone would silently have no state and the harness would fall back to
# asking a human, which is the exact failure it was built to remove. Checked in on purpose.
!plans/*campaign*-state.json

