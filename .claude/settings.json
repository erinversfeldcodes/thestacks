{
  "enableAllProjectMcpServers": true,
  "worktree": {
    "symlinkDirectories": ["deps", "_build", "node_modules", "apps/vision/.venv"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/lib/pre-stop-lint.sh"
          }
        ]
      }
    ]
  }
}
