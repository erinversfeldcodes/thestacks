# =============================================================================
# Phoenix / Elixir
# =============================================================================

# Ecto database connection URL (format: ecto://USER:PASS@HOST:PORT/DATABASE)
DATABASE_URL=ecto://postgres:postgres@localhost:5432/stacks_dev

# Base64-encoded secret for signing cookies and tokens.
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret

# Public-facing hostname (used for URL generation)
PHX_HOST=localhost

# HTTP port the Phoenix server listens on
PORT=4000

# Set to "true" to enable IPv6 for database connections (required on some Fly.io setups)
ECTO_IPV6=false

# Ecto connection pool size (default: 10)
POOL_SIZE=10

# Oban's dedicated pool (Core.ObanRepo, separate from POOL_SIZE). Prod default: 80.
# OBAN_POOL_SIZE=80

# Gates the server-only half of config/runtime.exs (endpoint binding, mailer,
# clustering, VISION_SERVICE_URL validation). deploy/Dockerfile.core sets it; a
# CI-side `mix ecto.migrate` deliberately leaves it unset. Not for local dev.
# PHX_SERVER=true

# Start the supervision tree WITHOUT the Phoenix endpoint — for release tasks that
# only need the repos. Any non-empty value enables it (Core.Application).
# STACKS_SKIP_ENDPOINT=1

# Injected by Fly.io on every machine. Presence activates Erlang clustering
# (config/runtime.exs) and scopes the transparency page's metric queries to this
# app (Stacks.Transparency). Never set by hand.
# FLY_APP_NAME=thestacks-core

# Set by `mix test --partitions N`; suffixes the test DB name (stacks_test1, …).
# Read in apps/core/config/test.exs. Never set by hand.
# MIX_TEST_PARTITION=

# =============================================================================
# Guardian (JWT authentication)
# =============================================================================

# Secret key for signing JWT tokens.
# Generate with: mix guardian.gen.secret
GUARDIAN_SECRET_KEY=generate-a-secret-key

# =============================================================================
# Cloak (field-level encryption for PII)
# =============================================================================

# 32-byte AES key, base64-encoded.
# Generate with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
CLOAK_KEY=generate-a-32-byte-base64-key

# =============================================================================
# Vision sidecar (Python/FastAPI — deployed to Modal)
# =============================================================================

# Environment name for the vision sidecar (development | production)
VISION_ENVIRONMENT=development

# URL of the deployed Modal vision service.
# Production: set automatically by deploy-preview.sh from the modal deploy output.
# Local dev: run `modal serve apps/vision/modal_app.py` and paste the printed URL,
#            or point at a locally running FastAPI server (e.g. http://localhost:8000).
VISION_SERVICE_URL=http://localhost:8000

# URL the vision sidecar uses to call back to the Phoenix core.
# In production on Fly.io this is http://core.internal:4000
VISION_CORE_URL=http://localhost:4000

# HMAC secret shared between Phoenix and the vision sidecar for request signing.
# Must be the same value in both services. Required at startup (not prod-only).
# Generate with: :crypto.strong_rand_bytes(64) |> Base.encode64()
VISION_HMAC_SECRET=generate-a-strong-random-secret

# Together AI API key for LLM features (used by vision sidecar)
VISION_TOGETHER_API_KEY=together-api-key-for-llm

# =============================================================================
# Scraper (Rust microservice)
# =============================================================================

# Rust log level filter (trace | debug | info | warn | error)
RUST_LOG=info

# HMAC auth for scraper sidecar (generate with: openssl rand -hex 32)
SCRAPER_HMAC_SECRET=generate-with-openssl-rand-hex-32

# URL of Rust scraper (default: http://localhost:8080)
SCRAPER_SERVICE_URL=http://localhost:8080

# =============================================================================
# dbt (data transforms)
# =============================================================================

# PostgreSQL connection for the stacks_dbt role
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=stacks_dbt
DBT_PASSWORD=stacks_dbt
DBT_DBNAME=stacks_dev

# Passwords for the stacks_app and stacks_dbt database roles.
# Required when running migrations against hosted databases (e.g. Neon) that enforce
# password strength policies. If not set, role creation is skipped and the application
# connects as the database owner role instead (safe for dev and preview environments).
# Generate with: openssl rand -base64 24
STACKS_APP_DB_PASSWORD=your-strong-password
STACKS_DBT_DB_PASSWORD=your-strong-password

# =============================================================================
# Object storage (Cloudflare R2 — optional; unset means the local filesystem)
# =============================================================================

# Setting R2_ACCOUNT_ID switches `:core, :storage` to Stacks.Storage.R2 and makes
# the next two REQUIRED at boot (System.fetch_env! in config/runtime.exs) — set all
# three or none.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket uploaded images land in. Default: stacks-images.
# R2_BUCKET_NAME=stacks-images

# =============================================================================
# External APIs
# =============================================================================

# Google Books API key (ISBN resolution fallback — optional, raises rate limit from 1k/day to quota)
# Obtain from: https://console.cloud.google.com/apis/credentials (Public data → API key, restrict to Books API)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Brave Search API key for source discovery
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# =============================================================================
# Fly.io (deployment only — not needed for local dev)
# =============================================================================

# API token for flyctl deployments.
# Must be an org-level token (not a deploy token) so that deploy-preview.sh can
# create and destroy ephemeral apps dynamically.
# Generate with: fly tokens create org --org personal
FLY_API_TOKEN=your-fly-api-token

# =============================================================================
# Neon (preview DB branching — only needed for deploy-preview.sh / CI)
# =============================================================================
#
# The Stacks uses two Neon projects with zero copy-on-write lineage:
#   - `thestacks`         — production data. Prod Fly app only.
#   - `thestacks-staging` — staging branch + every preview/<pr> branch.
# Previews are CoW children of `staging` inside `thestacks-staging`, so they
# inherit migrations + dev fixtures with zero chance of leaking prod data.
# See docs/deployment/NEON_BRANCH_TOPOLOGY.md for the full architecture.

# Neon project ID for the `thestacks-staging` project (NOT the prod project).
# Previews are created as branches inside this project.
# Obtain from: https://console.neon.tech → thestacks-staging → Settings → General
NEON_STAGING_PROJECT_ID=your-neon-staging-project-id

# Neon API key scoped to the staging project (or an account-level key).
# Used by deploy-preview.sh to create/delete preview branches.
# Obtain from: https://console.neon.tech → Account → API Keys → New API Key
NEON_STAGING_API_KEY=your-neon-staging-api-key

# Name of the parent branch for preview creation inside `thestacks-staging`.
# Default: `staging` — a branch containing migrations + the dev fixture set.
# See docs/deployment/NEON_BRANCH_TOPOLOGY.md.
NEON_PARENT_BRANCH=staging

# =============================================================================
# SearXNG (federated search — deployed as an internal Fly.io service)
# =============================================================================

# URL of the SearXNG instance. On Fly.io this is the internal hostname; for
# local dev, run SearXNG in Docker and point here (or leave unset to skip search).
SEARXNG_URL=http://localhost:8888

# Secret key for SearXNG's own request signing. Required by deploy-searxng.sh.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=generate-with-openssl-rand-hex-32

# =============================================================================
# Metrics & observability (ADR-021 — self-hosted VictoriaMetrics + Grafana)
# =============================================================================

# Bearer token StacksWeb.Plugs.MetricsAuth requires on every /internal/* route.
# Its reader is the SLO gate (scripts/check-slo-gate.sh); unset means no caller can
# read the exposition. Generate with: openssl rand -hex 32
# METRICS_SCRAPE_TOKEN=generate-with-openssl-rand-hex-32

# Where Core.PromEx.MetricsPusher POSTs the Prometheus exposition. Unset → the
# pusher stays a no-op. On Fly: http://thestacks-victoriametrics.internal:8428
# STACKS_METRICS_PUSH_URL=http://localhost:8428

# VictoriaMetrics base URL the public transparency page queries (/api/v1/query).
# Defaults to STACKS_METRICS_PUSH_URL; with neither set the live signals degrade to
# `:unavailable` — never a boot failure.
# STACKS_METRICS_QUERY_URL=http://localhost:8428

# Optional dashboards-as-code upload at boot. BOTH must be set or PromEx runs with
# `grafana: :disabled`. See docs/runbooks/metrics-stack.md.
# GRAFANA_HOST=http://localhost:3000
# GRAFANA_AUTH_TOKEN=your-grafana-service-account-token

# =============================================================================
# Feature flags & operational gates
# =============================================================================

# Age-gating kill-switch (ADR-020). Ships dark — OFF outside :test, so all three
# enforcement points are no-ops. Set true for a local or preview age-gate E2E run.
# AGE_GATING_ENABLED=false

# Gate on `Stacks.Release.seed/0` inside a release. Only ever true for dev/preview.
# ALLOW_SEEDS=false

# Enables the circuit-breaker smoke endpoint, which blows every fuse and waits ~30s
# for probe-driven recovery. NEVER set this in production.
# SMOKE_TESTS_ENABLED=false

# Mounts the /api/test/* E2E helper routes. Must be exactly "1" to open — any other
# value leaves them 404. Preview only; production never sets it.
# STACKS_E2E_TEST_HELPERS=1

# =============================================================================
# Release seeding identities (deploy-time only — not needed for local dev)
# =============================================================================

# Read by `Stacks.Release.seed_prod/0`, which creates the single owner user and
# raises without both. Staged as Fly secrets by scripts/deploy-stack.sh when set.
# PROD_OWNER_EMAIL=owner@example.com
# PROD_OWNER_PASSWORD=a-strong-owner-password

# Read by `Stacks.Release.seed_prober/0`, which creates the synthetic probe user
# (role "user", never "owner"). Raises without both.
# STACKS_PROBER_EMAIL=prober@example.com
# STACKS_PROBER_PASSWORD=a-strong-prober-password

# =============================================================================
# Replicate
# =============================================================================

REPLICATE_TOKEN=your-replicate-api-token

# =============================================================================
# Email
# =============================================================================

# Set to "resend" to enable real email delivery (via Resend.com)
EMAIL_PROVIDER=resend

# API key for Resend.com transactional email (only if EMAIL_PROVIDER=resend)
RESEND_API_KEY=your-resend-api-key

# Transactional-email sender address (REQUIRED for working prod email).
# Without it the app falls back to Resend's `onboarding@resend.dev` stopgap,
# which CANNOT deliver to real users (see apps/core/config/config.exs). Set to
# an address on a domain verified at resend.com/domains; deploy-stack.sh stages
# it as a Fly secret when present. Read in config/runtime.exs (prod server only).
# EMAIL_FROM=noreply@thestacks.app

# Opt `just run mix test` into exercising the REAL Resend send path (issue #258).
# Unset (the default), the email-delivery tests run hermetically against
# Swoosh.Adapters.Test — zero real emails — even with EMAIL_PROVIDER=resend +
# RESEND_API_KEY present. Set it to a Resend-accepted recipient to route the
# delivery tests through the real adapter. Do NOT set this in `.env`.
# TEST_EMAIL_RECIPIENT=erinversfeld@gmail.com

# =============================================================================
# Rate limiting (optional overrides)
# =============================================================================

# All four are per-IP over a 60s window; defaults live in
# StacksWeb.Plugs.RateLimiter. AUTH and PASSWORD_CHANGE are applied in the plug's
# GenServer init (so a Fly secret reliably lands); PUBLIC and E2E_HELPER are read in
# config/runtime.exs instead.

# Override default auth rate limit (optional). Default: 60.
# RATE_LIMIT_AUTH=100

# Password-change bucket. Default: 20.
# RATE_LIMIT_PASSWORD_CHANGE=20

# Public-endpoint bucket. Default: 200.
# RATE_LIMIT_PUBLIC=200

# /api/test/* helper bucket. Default: 10; preview raises it so the parallel E2E
# suite isn't throttled.
# RATE_LIMIT_E2E_HELPER=10

# NOTE: RELEASE_COOKIE needs no configuration — rel/env.sh.eex derives it
# from SECRET_KEY_BASE unconditionally on Fly machines, and local dev never
# clusters (clustering only activates when FLY_APP_NAME is set).
