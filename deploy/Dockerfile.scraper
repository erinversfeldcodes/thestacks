# Build stage — use Debian-based image for broader compatibility
FROM rust:1.88 AS builder

# hadolint ignore=DL3008
RUN rustup target add x86_64-unknown-linux-musl && \
    apt-get update && apt-get install -y --no-install-recommends musl-tools && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/scraper/Cargo.toml apps/scraper/Cargo.lock* ./
COPY apps/scraper/src ./src

RUN cargo build --release --target x86_64-unknown-linux-musl

# Runtime stage
FROM alpine:3.21

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates && addgroup -S stacks && adduser -S stacks -G stacks

WORKDIR /app
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/stacks-scraper ./stacks-scraper
COPY apps/scraper/scrapers ./scrapers

USER stacks

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["./stacks-scraper"]
