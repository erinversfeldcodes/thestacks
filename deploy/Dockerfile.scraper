# Build stage
FROM rust:1.84-alpine AS builder

RUN apk add --no-cache musl-dev=1.2.5-r9 && rustup target add x86_64-unknown-linux-musl

WORKDIR /app
COPY apps/scraper/Cargo.toml apps/scraper/Cargo.lock* ./
COPY apps/scraper/src ./src

RUN cargo build --release --target x86_64-unknown-linux-musl

# Runtime stage
FROM alpine:3.21.2

RUN apk add --no-cache ca-certificates=20250911-r0 && addgroup -S stacks && adduser -S stacks -G stacks

WORKDIR /app
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/stacks-scraper ./stacks-scraper

USER stacks

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["./stacks-scraper"]
