# Chef stage — installs cargo-chef and musl toolchain once, reused by planner + builder
FROM rust:1.88@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS chef

# --locked pins cargo-chef's transitive deps (e.g. cargo-platform) to the
# versions it was published with. Without this, cargo-platform 0.3.3 gets
# pulled in and demands rustc 1.91, which mismatches the 1.88 base image.
# hadolint ignore=DL3008
RUN cargo install cargo-chef --locked && \
    rustup target add x86_64-unknown-linux-musl && \
    apt-get update && apt-get install -y --no-install-recommends musl-tools && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Planner stage — computes dependency recipe from Cargo.toml/Cargo.lock
FROM chef AS planner
COPY apps/scraper/ .
RUN cargo chef prepare --recipe-path recipe.json

# Builder stage — bakes dependencies (cached), then compiles app
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# This layer only re-runs when Cargo.lock changes
RUN cargo chef cook --release --target x86_64-unknown-linux-musl --recipe-path recipe.json
COPY apps/scraper/ .
RUN cargo build --release --target x86_64-unknown-linux-musl

# Runtime stage
FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates && addgroup -S stacks && adduser -S stacks -G stacks

WORKDIR /app
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/stacks-scraper ./stacks-scraper
COPY apps/scraper/scrapers ./scrapers

USER stacks

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["./stacks-scraper"]
