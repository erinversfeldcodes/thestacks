FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6 AS runtime

# pyzbar requires libzbar at runtime for barcode decoding.
# hadolint ignore=DL3008,DL3009
RUN apt-get update && \
    apt-get install -y --no-install-recommends libzbar0t64 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Hash-pinned lock (self-contained; regenerate with `just lock-vision`).
COPY apps/vision/requirements.lock requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

COPY apps/vision/app app/

RUN useradd --create-home --shell /bin/bash appuser
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
