# RETIRED: The vision sidecar is now hosted on Modal as an ASGI app.
# See apps/vision/modal_app.py — the vision_api function decorated with @modal.asgi_app().
# Deploy: modal deploy apps/vision/modal_app.py
# Endpoint: https://erinversfeldcodes--thestacks-vision-vision-api.modal.run

FROM python:3.12-slim

RUN groupadd -r stacks && useradd -r -g stacks stacks

WORKDIR /app

COPY apps/vision/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/vision/app ./app

USER stacks

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
