# Build stage
FROM hexpm/elixir:1.18.4-erlang-28.4-alpine-3.21.6 AS builder

RUN apk add --no-cache build-base=0.5-r3 git=2.47.3-r0 nodejs=22.15.1-r0 npm=10.9.1-r0

WORKDIR /app

ENV MIX_ENV=prod

RUN mix local.hex --force && mix local.rebar --force

# Copy only what mix deps.get needs — changes here bust the deps cache.
COPY mix.exs mix.lock ./
COPY apps/core/mix.exs apps/core/mix.exs
RUN mix deps.get --only prod && mix deps.compile

# Config and priv — changes here re-run compile+release, not deps.
# Priv (migrations) is placed before lib because it changes less often
# than app code, so a code-only change doesn't bust the priv layer.
COPY config/config.exs config/config.exs
COPY config/prod.exs config/prod.exs
COPY config/runtime.exs config/runtime.exs
COPY apps/core/config/ apps/core/config/
COPY apps/core/priv apps/core/priv

# Source code — most frequently changed layer, last before compilation.
COPY apps/core/lib apps/core/lib

# Asset pipeline: install npm deps (cached layer, changes only when package.json changes)
COPY apps/core/assets/package.json apps/core/assets/package-lock.json* apps/core/assets/
WORKDIR /app/apps/core/assets
RUN npm ci

# Copy asset build infrastructure (no symlinks — those are local dev only)
WORKDIR /app
COPY apps/core/assets/build.js apps/core/assets/build.js
COPY apps/core/assets/js apps/core/assets/js

# Copy frontend sources directly into the paths build.js expects.
# elm.json source-directories includes "../proto/gen/elm" which resolves
# to apps/core/assets/proto/gen/elm when Elm compiles from the elm/ CWD.
COPY frontend/src apps/core/assets/elm/src
COPY frontend/elm.json apps/core/assets/elm/elm.json
COPY proto/gen/elm apps/core/assets/proto/gen/elm
COPY frontend/css apps/core/assets/css
COPY frontend/public apps/core/assets/static

# Build assets via esbuild + esbuild-plugin-elm, then generate digest manifest
WORKDIR /app/apps/core/assets
RUN node build.js --production

# Compile Elixir, fingerprint static assets, build release
WORKDIR /app
RUN mix compile && mix phx.digest && mix release core

# Runtime stage
FROM alpine:3.21.6 AS runtime

RUN apk add --no-cache libstdc++=14.2.0-r4 openssl=3.3.6-r0 ncurses-libs=6.5_p20241006-r3

RUN addgroup -S stacks && adduser -S stacks -G stacks
WORKDIR /app

COPY --from=builder --chown=stacks:stacks /app/_build/prod/rel/core ./

# Use the native OS resolver (musl getaddrinfo) instead of Erlang's inet_res.
# musl automatically opens IPv6 sockets when the nameserver is IPv6, allowing
# Oban jobs to resolve *.internal hostnames via Fly's DNS at fdaa::3 without
# setting inet6: true globally (which disrupts Oban's DB connections).
RUN mkdir -p /app/etc && echo '{lookup, [native]}.' > /app/etc/inetrc && chown stacks:stacks /app/etc/inetrc

USER stacks

ENV PHX_SERVER=true
ENV ERL_INETRC=/app/etc/inetrc
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:4000/api/health || exit 1

CMD ["bin/core", "start"]
