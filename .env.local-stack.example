# The Stacks — local full-stack profile: the seam variables.
#
# These are the five environment variables that decide whether Phoenix talks to
# the local side services or to nothing at all. They are ADDITIVE to your normal
# .env (which still supplies DATABASE_URL, CLOAK_KEY, VISION_HMAC_SECRET and the
# rest) — copy the lines you want into .env, or source this file after it:
#
#   set -a; source .env; source .env.local-stack.example; set +a
#   just run mix phx.server
#
# Every one of them is already read by config/runtime.exs, so nothing here needs
# an app-code change. Bring-up and the mechanism proofs: docs/local-full-stack.md
#
# ⚠️ config/runtime.exs skips its whole non-test block under MIX_ENV=test, so
# these have no effect on `mix test`. That is deliberate — the test suite must
# never reach a real service.

# --- Metrics: push, then read back ------------------------------------------
#
# BASE URLs, not endpoint paths. Core.PromEx.MetricsPusher.build_url/1 appends
# `/api/v1/import/prometheus` (plus the `extra_label=app=…` query) itself, and
# Stacks.Transparency.Prometheus appends `/api/v1/query`. Setting either of
# these to a full path yields a 404 on every push and a silently empty live
# section — the failure looks exactly like "no data yet".
STACKS_METRICS_PUSH_URL=http://localhost:8428

# Where the public /metrics page reads its live signals from. Defaults to
# STACKS_METRICS_PUSH_URL when unset, so it is only worth setting explicitly if
# you want reads and writes to go to different stores.
STACKS_METRICS_QUERY_URL=http://localhost:8428

# --- Discovery ---------------------------------------------------------------
#
# The compose file publishes SearXNG on 8888 to match the default already
# compiled into Core.Application, so this line is belt-and-braces.
SEARXNG_URL=http://localhost:8888

# --- Bookshop price scraper --------------------------------------------------
#
# The Rust service runs natively (`cargo run` in apps/scraper), not in compose.
# 8080 is its default SCRAPER_PORT and also Core.Application's default for
# :scraper_service_url.
SCRAPER_SERVICE_URL=http://localhost:8080

# Must be byte-identical to the SCRAPER_HMAC_SECRET the Rust process starts
# with, or every request is rejected at its auth middleware before any scrape
# runs — a 401 that reads like the store being unreachable. Any non-empty string
# works locally; this is not a production secret.
SCRAPER_HMAC_SECRET=local-dev-scraper-secret

# --- Optional: E2E helper endpoints ------------------------------------------
#
# Unlocks POST /api/test/session, which is how the documented authenticated
# drive recipe gets a logged-in browser without the register→confirm→login
# dance. Local and preview only — never set on prod.
STACKS_E2E_TEST_HELPERS=1
