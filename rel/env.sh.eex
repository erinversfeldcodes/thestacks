#!/bin/sh
# Erlang distribution — required for Phoenix.PubSub (pg adapter) to work
# across multiple Fly.io machines. Fly sets FLY_APP_NAME and FLY_PRIVATE_IP
# automatically on every machine.
#
# Without this, PubSub broadcasts from Oban workers on Machine A do not reach
# SSE connections held on Machine B, causing upload streams to time out.
if [ -n "$FLY_APP_NAME" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
  # All machines must share the same cookie for Erlang distribution to work.
  # Derive it from SECRET_KEY_BASE (already set on every machine via Fly secrets).
  # Without this, each machine generates a random cookie and peers cannot authenticate.
  export RELEASE_COOKIE="${SECRET_KEY_BASE}"
  # Fly's 6PN private network is IPv6-only. Without inet6_tcp, Erlang defaults to
  # IPv4 TCP for distribution and cannot reach peers whose addresses are IPv6.
  export ERL_FLAGS="-proto_dist inet6_tcp"
fi
