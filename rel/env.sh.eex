#!/bin/sh
# Erlang distribution — required for Phoenix.PubSub (pg adapter) to work
# across multiple Fly.io machines. Fly sets FLY_APP_NAME and FLY_PRIVATE_IP
# automatically on every machine.
#
# Without this, PubSub broadcasts from Oban workers on Machine A do not reach
# SSE connections held on Machine B, causing upload streams to time out.
if [ -n "$FLY_APP_NAME" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
fi
